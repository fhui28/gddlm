Package: gddlm
Title: Robust double linear models using gamma divergence
Version: 0.1
Date: 2025-07-01
Authors@R: c(person(given = c("Francis", "K.C."),
                        family = "Hui",
                        role = c("aut", "cre"),
                        email = "francis.hui@anu.edu.au",
                        comment = c(ORCID = "0000-0003-0765-3533")),
